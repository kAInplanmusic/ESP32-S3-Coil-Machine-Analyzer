# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

# Database
DATABASE_PATH=./data/measurements.db

# API Configuration
API_VERSION=v1
MAX_FILE_UPLOAD_SIZE=50mb

# WebSocket Configuration
WS_PORT=3002
ENABLE_WS=true

# Audio Configuration
SAMPLE_RATE=44100
FFT_SIZE=2048
IMPACT_MEASURE_COUNT=100

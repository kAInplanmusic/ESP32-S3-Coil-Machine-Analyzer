{
  "name": "coil-analyzer-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile Coil Machine Analyzer (React Native for Android/iOS)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "expo start --web",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "xcodebuild -workspace ios/CoilAnalyzer.xcworkspace -scheme CoilAnalyzer -configuration Release"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-native-permissions": "^3.9.0",
    "react-native-audio": "^4.11.0",
    "react-navigation": "^6.0.0",
    "react-native-screens": "^3.0.0",
    "react-native-safe-area-context": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.0.0",
    "@react-native-community/eslint-config": "^3.0.0",
    "babel-jest": "^29.0.0",
    "jest": "^29.0.0",
    "metro-react-native-babel-preset": "^0.76.0",
    "typescript": "^5.0.0",
    "@types/react": "18.2.0",
    "@types/react-native": "0.72.0"
  },
  "jest": {
    "preset": "react-native"
  }
}
